# ── Active provider & model ────────────────────────────────────────────────
# Which LLM to use for the agent. Options: anthropic | openai | gemini | groq | mistral | ollama
ACTIVE_PROVIDER=provider
MODEL=model

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=anthropic_api_key

# ── OpenAI (GPT-4o, GPT-4 Turbo, etc.) ────────────────────────────────────
OPENAI_API_KEY=openai_api_key

# ── Google Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=gemini_api_key

# ── Groq (fast inference — Llama, Mixtral) ─────────────────────────────────
GROQ_API_KEY=grok_api_key

# ── Mistral AI ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=mistral_api_key

# ── Together AI ────────────────────────────────────────────────────────────
TOGETHER_API_KEY=api_key

# ── Ollama (local, no key needed) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── Browser Use agent ──────────────────────────────────────────────────────
# browser-use uses the same LLM keys above — no extra key needed.
# Set this to limit how many browser steps an agent can take before stopping.
BROWSER_USE_MAX_STEPS=int

# ── App config ─────────────────────────────────────────────────────────────
# Root folder the search_files tool is allowed to scan
SEARCH_ROOT=<Default to user home>/Documents

#WEATHER API KEY
WEATHER_API_KEY = your_api_key_here
URL_WEATHER_API = site
# GOOGLE AUTH SITE AND API
GOOGLEURL_AUTH=url