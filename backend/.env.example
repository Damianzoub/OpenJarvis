# ── Active provider & model ────────────────────────────────────────────────
# Which LLM to use for the agent. Options: anthropic | openai | gemini | groq | mistral | ollama
ACTIVE_PROVIDER=anthropic
MODEL=claude-sonnet-4-6

# ── Anthropic (Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (GPT-4o, GPT-4 Turbo, etc.) ────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google Gemini ──────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...

# ── Groq (fast inference — Llama, Mixtral) ─────────────────────────────────
GROQ_API_KEY=gsk_...

# ── Mistral AI ─────────────────────────────────────────────────────────────
MISTRAL_API_KEY=...

# ── Together AI ────────────────────────────────────────────────────────────
TOGETHER_API_KEY=...

# ── Ollama (local, no key needed) ──────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── Browser Use agent ──────────────────────────────────────────────────────
# browser-use uses the same LLM keys above — no extra key needed.
# Set this to limit how many browser steps an agent can take before stopping.
BROWSER_USE_MAX_STEPS=20

# ── App config ─────────────────────────────────────────────────────────────
# Root folder the search_files tool is allowed to scan
SEARCH_ROOT=~/Documents
